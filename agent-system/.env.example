# ── Copy this file to .env for local runs. In GitHub Actions, set the same
# ── names as repository secrets (Settings > Secrets and variables > Actions).
# ── Nothing in this file is a real credential.

# ─────────────────────────────────────────────────────────────────────────
# Core: the "brain" every agent uses to think, write, and verify
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Core: shared memory (Supabase Postgres project)
# Create a free project at supabase.com, then Project Settings > API.
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key, used only by dashboard.html in the browser (safe to expose,
# access is restricted by Row Level Security policies — see schema.sql).
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────
# The business this instance runs for. Point it at any business's site and
# the Business Analyzer agent takes it from there.
# ─────────────────────────────────────────────────────────────────────────
BUSINESS_WEBSITE_URL=https://example.com
BUSINESS_SLUG=assetforge

# ─────────────────────────────────────────────────────────────────────────
# Safety valve: if false, EVERY post — even ones Brand Guardian fully
# approves — is held for a human click in dashboard.html instead of being
# published automatically. Flip to true once you trust the pipeline.
# See README "Turning on autonomy" before setting this to true.
# ─────────────────────────────────────────────────────────────────────────
AUTO_PUBLISH_ENABLED=false
# Brand Guardian's approval score (0-100) must meet this bar to auto-publish
# even when AUTO_PUBLISH_ENABLED=true. Anything below always goes to a human.
AUTO_PUBLISH_MIN_SCORE=90

# Comma-separated subset of: x,linkedin,facebook,instagram,tiktok,pinterest
# Trim to only the platforms you actually have credentials for below —
# otherwise the calendar plans content for platforms that can only dry-run.
ACTIVE_PLATFORMS=x,linkedin,facebook,instagram,tiktok,pinterest
# How many days ahead runContentGeneration.ts plans in one run, and how many
# posts per platform per day. 7 days x 2/day x 6 platforms = 84 posts per run.
CONTENT_CALENDAR_DAYS=7
POSTS_PER_PLATFORM_PER_DAY=2

# ─────────────────────────────────────────────────────────────────────────
# Optional: powers the visual content agent (generates the actual images
# for Instagram/Pinterest posts from each post's mediaBrief). Without this,
# those posts just wait in dashboard.html for a human to paste a mediaUrl.
# Also requires a PUBLIC Supabase Storage bucket named "post-media" —
# create it once in the Supabase dashboard (Storage > New bucket > Public).
# ─────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional: powers the video content agent (generates ~15s vertical videos
# for TikTok from each post's mediaBrief, via Google's Veo model). Get a key
# at aistudio.google.com/apikey — Veo generation requires a paid/billed
# Gemini API key, not the free tier. Also uses the same "post-media"
# Supabase Storage bucket as images (see OPENAI_API_KEY above), and
# requires the `ffmpeg` binary on PATH wherever this script runs (already
# present on GitHub Actions' ubuntu-latest runners).
# ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# X (Twitter) — developer.x.com, needs a Project + App with OAuth 1.0a
# User Context (read+write) or OAuth2 with offline.access.
# ─────────────────────────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# LinkedIn — developer.linkedin.com, needs a Company Page + app with the
# "Share on LinkedIn" / "Community Management API" product approved, plus
# an OAuth access token with w_member_social or w_organization_social scope.
# ─────────────────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# ─────────────────────────────────────────────────────────────────────────
# Meta (Facebook Page + Instagram Business/Creator account) —
# developers.facebook.com, needs an App in Live mode with
# pages_manage_posts, pages_read_engagement, instagram_content_publish.
# Meta's app review is the slowest step in this whole system — budget
# 1-2 weeks. Use a long-lived Page Access Token (60 days, auto-refresh
# logic is in platforms/meta.ts).
# ─────────────────────────────────────────────────────────────────────────
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────────────────────────────────
# TikTok — developers.tiktok.com, Content Posting API requires app audit
# (submit real sample posts for review before you get unaudited-client
# limits lifted).
# ─────────────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ─────────────────────────────────────────────────────────────────────────
# Pinterest — developers.pinterest.com, standard API access + a connected
# Business account and a default Board ID to publish Pins to.
# ─────────────────────────────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
